  "scripts": {
    "build": "node ../../scripts/sync-exports.mjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\" && node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\" && node -e \"require('fs').copyFileSync('../../README.md','README.md')\"",
    "typecheck": "node ../../scripts/sync-exports.mjs && tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node -e \"if (require('./package.json').license !== 'MIT') { console.error('Publish from the public repository (MIT edition), not the private one.'); process.exit(1) }\" && npm run build"
  },
